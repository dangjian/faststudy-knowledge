# 仅 `src/llm_*.py` 批处理备选脚本需要：复制为 .env（或直接注入环境变量）。
# agent 工作流（默认路径）不读此文件，无需配置。凭据统一一套，适用于任何 OpenAI 兼容服务
# （如 DeepSeek：AI_BASE_URL=https://api.deepseek.com）。
AI_API_KEY=            # 必填（使用 llm_*.py 时）
AI_BASE_URL=           # 可选，缺省=OpenAI 官方端点
AI_MODEL=              # 必填，如 deepseek-chat / gpt-4o-mini
AI_REASONING_EFFORT=   # 可选，推理力度：none/low/medium/high

# 摄入管线：教材源图目录（含 <教材id>/pages、metadata.json），默认即仓内 source_data/
KG_SOURCE_DIR=./source_data

# 页图 CDN 基址（可选，构建 dist 时派生 Section.pageImages；未设置=不产页图）
KG_PAGE_IMAGE_BASE_URL=
